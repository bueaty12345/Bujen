<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">



    <!-- 阴影层 -->
    <item android:left="16dp" android:top="56dp">
        <shape android:shape="rectangle">
            <solid android:color="#80BDAB96"/> <!-- 透明色，作为阴影 -->
            <corners android:radius="15dp"/>
        </shape>
    </item>

    <!-- 主形状层，向下和向右移动 -->
    <item android:left="13dp" android:top="53dp" android:right="3.5dp" android:bottom="3.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp"/>
            <solid android:color="#FFFDF6"/>
            <stroke
                android:width="1.5dp"
                android:color="#000000"/>
        </shape>
    </item>
    <!-- 图片层 -->
    <item>
        <bitmap
            android:src="@drawable/shuzhi"
            android:tileMode="disabled"
            android:gravity="top|left" />
    </item>

</layer-list>
