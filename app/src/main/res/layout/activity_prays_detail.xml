<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PraysDetail"
    android:background="#ECE0D2">

    <LinearLayout
        android:id="@+id/linearLayout9"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_back"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/back" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:gravity="right|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_home_gdd"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginRight="5dp"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="#49392D"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/imageView24"
                    android:layout_width="35dp"
                    android:layout_height="29dp"
                    app:srcCompat="@drawable/icon_gdd" />

            </LinearLayout>

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="193dp"
                    android:layout_margin="0dp"
                    android:layout_marginTop="10dp"
                    android:background="#FFFCF3"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:id="@+id/img_cover"
                            android:layout_width="match_parent"
                            android:layout_height="193dp"
                            android:background="@drawable/recommend1">

                            <TextView
                                android:id="@+id/txt_time"
                                android:layout_width="26dp"
                                android:layout_height="36dp"
                                android:layout_alignParentTop="true"
                                android:layout_alignParentEnd="true"
                                android:layout_marginTop="-7dp"
                                android:layout_marginEnd="21dp"
                                android:background="#8053402E"
                                android:gravity="bottom|center"
                                android:paddingBottom="4dp"
                                android:text="基础"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp" />

                        </RelativeLayout>

                    </LinearLayout>


                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txt_mname"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="尘烟"
                                android:textColor="#000000"
                                android:textSize="18sp"
                                android:textStyle="normal" />


                            <ImageView
                                android:id="@+id/img_selet"
                                android:layout_width="16dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="right|center_vertical"
                                android:layout_marginLeft="20dp"
                                app:srcCompat="@drawable/collection_2" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center|right"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/img_star"
                                android:layout_width="23dp"
                                android:layout_height="14dp"
                                app:srcCompat="@drawable/icon_star" />

                            <TextView
                                android:id="@+id/txt_star"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4.8"
                                android:textSize="10sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txt_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2024-11-14"
                            android:textColor="#9949392D"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/imageView2"
                            android:layout_width="12dp"
                            android:layout_height="22dp"
                            android:layout_marginLeft="8dp"
                            android:layout_marginRight="8dp"
                            app:srcCompat="@drawable/icon_cf" />

                        <TextView
                            android:id="@+id/txt_blessingMethod"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="800字限定"
                            android:textColor="#9949392D"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_gdd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="需功德值：35000"
                        android:textColor="#000000"
                        android:textSize="20sp"
                        android:textStyle="normal" />

                    <View
                        android:id="@+id/div_tab_bar3"
                        android:layout_width="match_parent"
                        android:layout_height="3px"
                        android:layout_above="@id/ly_tab_bar"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp"
                        android:alpha="0.15"
                        android:background="#49392D"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/textView22"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="“隐入尘烟处，来去皆随风;炊烟渐起时，相守即是终。
“尘归尘，土归土，最终被吸尽最后一滴血隐入尘烟，寻着那朵花去寻找属于自己的救赎。”"
                        android:textSize="10sp" />
                    <Button
                        android:id="@+id/btn_dh"
                        android:layout_width="226dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="26dp"
                        android:background="@drawable/roundgray00"
                        android:backgroundTint="#F8FFFFFF"
                        android:gravity="center"
                        android:text="兑换"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="normal" />

                    <Button
                        android:id="@+id/btn_again"
                        android:layout_width="226dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="13dp"
                        android:layout_marginBottom="5dp"
                        android:background="@drawable/roundgray00"
                        android:backgroundTint="#DED1C1"
                        android:gravity="center"
                        android:text="已拥有0"
                        android:textColor="#49392D"
                        android:textSize="16sp"
                        android:textStyle="normal" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="28dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView23"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="相关推荐"
                        android:textColor="#1C1B1F"
                        android:textSize="18sp" />

                    <GridView
                        android:id="@+id/grid_tj"
                        android:layout_width="match_parent"
                        android:layout_height="500dp"
                        android:divider="@android:color/transparent"
                        android:listSelector="@android:color/transparent"
                        android:nestedScrollingEnabled="true"
                        android:numColumns="2"
                        android:scrollbars="none" />

                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>