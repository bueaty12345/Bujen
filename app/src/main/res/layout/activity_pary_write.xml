<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECE0D2"
    tools:context=".pary.ParyWrite">

    <LinearLayout
        android:id="@+id/linearLayout17"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:id="@+id/img_back"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/icon_cuo" />

            <ImageView
                android:id="@+id/img_chehui"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/icon_chehui" />

            <ImageView
                android:id="@+id/img_huifu"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/icon_huifu" />

            <ImageView
                android:id="@+id/img_ok"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/icon_dui" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:id="@+id/txt_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="2024年12月25日 11：45" />

            <View
                android:id="@+id/div_tab_bar6"
                android:layout_width="2px"
                android:layout_height="match_parent"
                android:layout_below="@+id/linearLayout13"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:background="#BBAEA1"
                android:visibility="visible" />

            <TextView
                android:id="@+id/txt_sort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:text="6’00”" />

        </LinearLayout>

        <View
            android:id="@+id/div_tab_bar7"
            android:layout_width="match_parent"
            android:layout_height="3px"
            android:layout_below="@+id/linearLayout13"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="0dp"
            android:background="#BBAEA1"
            android:visibility="visible" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/lin_write"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp">

                    <EditText
                        android:id="@+id/edtxt_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@android:color/transparent"
                        android:ems="10"
                        android:hint="标题"
                        android:inputType="text"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtxt_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@android:color/transparent"
                        android:ems="10"
                        android:gravity="start|top"
                        android:hint="内容..."
                        android:inputType="textMultiLine" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/lin_high"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 背景图片 -->
            <ImageView
                android:id="@+id/imageView33"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="-1dp"
                android:layout_marginBottom="0dp"
                app:srcCompat="@drawable/bg_write" />

            <!-- 扇形展开的按钮1 -->
            <ImageView
                android:id="@+id/img_zp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="25dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:srcCompat="@drawable/icon_zp" />

            <!-- 扇形展开的按钮2 -->
            <ImageView
                android:id="@+id/img_xj"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="25dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:srcCompat="@drawable/icon_xj" />

            <!-- 主按钮 -->
            <ImageView
                android:id="@+id/img_main"
                android:layout_width="67dp"
                android:layout_height="67dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="25dp"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/icon_tu" />
        </RelativeLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>