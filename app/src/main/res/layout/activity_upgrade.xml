<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f1e7d9"
    tools:context=".device.Upgrade">

    <LinearLayout
        android:id="@+id/linearLayout12"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            >

            <ImageView
                android:id="@+id/img_back"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="0dp"
                app:srcCompat="@drawable/back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"  />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="设备升级"
                android:textColor="#000000"
                android:textSize="24sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"  />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="396dp"
            android:layout_margin="20dp"
            android:background="@drawable/roundgray"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="180dp"
                android:layout_height="180dp"
                app:srcCompat="@drawable/icon_upgrade"
                android:layout_gravity="center"/>

            <TextView
                android:id="@+id/txt_new"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="是否需要更新"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/txt_mz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="模组信息"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/txt_mcu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="mcu信息"
                android:layout_gravity="center" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/auto_upgrade"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/roundgray"
            android:paddingVertical="12dp"
            android:paddingHorizontal="16dp"
            android:layout_marginHorizontal="20dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_tv_feedback"
                style="@style/ItemTextStyle2"
                android:text="自动升级" />

            <Switch
                android:id="@+id/sw_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="12dp"
            android:paddingHorizontal="16dp"
            android:layout_marginHorizontal="20dp"
            android:gravity="center">

            <TextView
                style="@style/autoUpGradeStyle2"
                android:text="开启自动升级功能后，设备将自动进行升级，重要功能升级人需确认后进行" />

        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>