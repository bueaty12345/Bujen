<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="343dp"
    android:layout_height="168dp"
    android:background="@drawable/icon_praybg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tv_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="您今日有 n 条接福数据"
            android:textColor="#49392D"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="32dp"
            android:textSize="16sp"/>


        <LinearLayout
            android:id="@+id/ll_single_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="38dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tv_row1_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="福往: /"
                android:textColor="#49392D"
                android:gravity="left"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/tv_row1_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025 年 07 月 02日"
                android:textColor="#49392D"
                android:gravity="left"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_single_data1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tv_row2_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="福来: /"
                android:textColor="#49392D"
                android:gravity="left"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/tv_row2_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025 年 07 月 02日"
                android:textColor="#49392D"
                android:gravity="left"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/div_tab_bar4"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_above="@id/ly_tab_bar"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp"
        android:alpha="0.15"
        android:background="#49392D"
        android:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_cancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="取消"
            android:textColor="#928A8A"
            android:textSize="16sp" />

        <View
            android:id="@+id/div_tab_bar5"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:layout_above="@id/ly_tab_bar"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:alpha="0.15"
            android:background="#49392D"
            android:visibility="visible" />

        <TextView
            android:id="@+id/txt_confirm"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="确定"
            android:textColor="#C71D1E"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>