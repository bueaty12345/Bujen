<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/y_bg1"
    tools:context=".ZenbeatSetting">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/img_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="木鱼设置"
                android:textColor="#000000"
                android:textSize="24sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/roundgray"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:layout_marginTop="22dp"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/img_sy"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:padding="10dp"
                                app:srcCompat="@drawable/laba" />

                            <Switch
                                android:id="@+id/switch_sy"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:checked="true"
                                android:text="声音设置"
                                android:textSize="18sp"
                                app:trackTint="#849187"
                                app:thumbTint="#FFFFFF"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/lin_yl"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <View
                                android:id="@+id/div_tab_bar10"
                                android:layout_width="match_parent"
                                android:layout_height="3px"
                                android:layout_above="@id/ly_tab_bar"
                                android:layout_marginLeft="5dp"
                                android:layout_marginRight="5dp"
                                android:layout_marginBottom="12dp"
                                android:background="#DED1C1"
                                android:visibility="visible" />

                            <TextView
                                android:id="@+id/textView42"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="16dp"
                                android:text="音量"
                                android:textColor="#000000"
                                android:textSize="16sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="20dp">

                                <!-- -按钮 -->
                                <ImageView
                                    android:id="@+id/volume_minus"
                                    android:layout_width="29dp"
                                    android:layout_height="29dp"
                                    android:layout_marginRight="10dp"
                                    android:background="?android:attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="Decrease Volume"
                                    android:src="@drawable/ic_minus" />

                                <!-- 音量条 -->

                                <LinearLayout
                                    android:id="@+id/volume_container"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:id="@+id/volume_bar"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginLeft="5dp"
                                        android:layout_marginRight="5dp"
                                        android:scaleType="fitCenter"
                                        android:src="@drawable/volume_1" />
                                </LinearLayout>

                                <!-- +按钮 -->
                                <ImageView
                                    android:id="@+id/volume_plus"
                                    android:layout_width="29dp"
                                    android:layout_height="29dp"
                                    android:layout_marginLeft="10dp"
                                    android:src="@drawable/ic_plus" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lin_sy"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/roundgray"
                        android:orientation="vertical"
                        android:visibility="visible" >

                        <LinearLayout
                            android:id="@+id/lin_ding"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:padding="25dp">

                            <TextView
                                android:id="@+id/textView5"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="叮叮"
                                android:textColor="#000000"
                                android:textSize="16sp" />

                            <ImageView
                                android:id="@+id/img_ding"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                app:srcCompat="@drawable/icon_select2" />
                        </LinearLayout>

                        <View
                            android:id="@+id/div_tab_bar15"
                            android:layout_width="match_parent"
                            android:layout_height="3px"
                            android:layout_above="@id/ly_tab_bar"
                            android:layout_marginLeft="5dp"
                            android:layout_marginRight="5dp"
                            android:layout_marginBottom="12dp"
                            android:background="#DED1C1"
                            android:visibility="visible" />

                        <LinearLayout
                            android:id="@+id/lin_dong"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:padding="25dp">

                            <TextView
                                android:id="@+id/textView6"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="咚咚"
                                android:textColor="#000000"
                                android:textSize="16sp" />

                            <ImageView
                                android:id="@+id/img_dong"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:visibility="invisible"
                                app:srcCompat="@drawable/icon_select2" />
                        </LinearLayout>

                        <View
                            android:id="@+id/div_tab_bar14"
                            android:layout_width="match_parent"
                            android:layout_height="3px"
                            android:layout_above="@id/ly_tab_bar"
                            android:layout_marginLeft="5dp"
                            android:layout_marginRight="5dp"
                            android:layout_marginBottom="12dp"
                            android:background="#DED1C1"
                            android:visibility="visible" />

                        <LinearLayout
                            android:id="@+id/lin_fc"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:padding="25dp">

                            <TextView
                                android:id="@+id/textView66"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="发财"
                                android:textColor="#000000"
                                android:textSize="16sp" />

                            <ImageView
                                android:id="@+id/img_fc"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:visibility="invisible"
                                app:srcCompat="@drawable/icon_select2" />
                        </LinearLayout>

                        <View
                            android:id="@+id/div_tab_bar13"
                            android:layout_width="match_parent"
                            android:layout_height="3px"
                            android:layout_above="@id/ly_tab_bar"
                            android:layout_marginLeft="5dp"
                            android:layout_marginRight="5dp"
                            android:layout_marginBottom="12dp"
                            android:background="#DED1C1"
                            android:visibility="visible" />

                        <LinearLayout
                            android:id="@+id/lin_jk"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:padding="25dp">

                            <TextView
                                android:id="@+id/textView55"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="健康"
                                android:textColor="#000000"
                                android:textSize="16sp" />

                            <ImageView
                                android:id="@+id/img_jk"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:visibility="invisible"
                                app:srcCompat="@drawable/icon_select2" />
                        </LinearLayout>

                        <View
                            android:id="@+id/div_tab_bar12"
                            android:layout_width="match_parent"
                            android:layout_height="3px"
                            android:layout_above="@id/ly_tab_bar"
                            android:layout_marginLeft="5dp"
                            android:layout_marginRight="5dp"
                            android:layout_marginBottom="12dp"
                            android:background="#DED1C1"
                            android:visibility="visible" />

                        <LinearLayout
                            android:id="@+id/lin_tmd"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:padding="25dp">

                            <TextView
                                android:id="@+id/textView49"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="***"
                                android:textColor="#000000"
                                android:textSize="16sp" />

                            <ImageView
                                android:id="@+id/img_tmd"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:visibility="invisible"
                                app:srcCompat="@drawable/icon_select2" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>