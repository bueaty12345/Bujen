<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/y_bg1"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".setting.ProfileEditor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/img_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="资料编辑"
                android:textColor="#000000"
                android:textSize="22sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <!-- 模块A -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/item_setting"
                    android:layout_marginTop="16dp"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:id="@+id/lin_headPortrait"
                        style="@style/ItemRowStyle">

                        <TextView
                            android:id="@+id/tv_headPortrait"
                            style="@style/ItemTextStyle2"
                            android:text="头像" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/img_icon_headPortrait"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/icon_phonenumber"
                                android:layout_gravity="center_vertical"
                                android:contentDescription="图标"/>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/img_arrow"
                            style="@style/ItemArrowStyle" />
                    </LinearLayout>


                </LinearLayout>

                <!-- 模块B -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/item_setting"
                    android:layout_marginTop="16dp"
                    android:paddingVertical="8dp">


                    <LinearLayout
                        android:id="@+id/lin_nickname"
                        style="@style/ItemRowStyle">

                        <TextView
                            style="@style/ItemTextStyle2"
                            android:text="昵称" />

                        <TextView
                            android:id="@+id/tv_nickname_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="摸鱼高阶选手"
                            android:textSize="12sp"
                            android:textColor="#999999"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_vertical" />
                        <ImageView
                            style="@style/ItemArrowStyle" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CCCCCC"
                        android:layout_marginHorizontal="16dp"/>

                    <LinearLayout
                        android:id="@+id/lin_gender"
                        style="@style/ItemRowStyle">

                        <TextView
                            style="@style/ItemTextStyle2"
                            android:text="性别" />

                        <TextView
                            android:id="@+id/tv_gender_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="女"
                            android:textSize="12sp"
                            android:textColor="#999999"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_vertical" />
                        <ImageView
                            style="@style/ItemArrowStyle" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CCCCCC"
                        android:layout_marginHorizontal="16dp"/>

                    <LinearLayout
                        android:id="@+id/lin_signature"
                        style="@style/ItemRowStyle">

                        <TextView
                            style="@style/ItemTextStyle2"
                            android:text="个性签名" />

                        <TextView
                            android:id="@+id/tv_signature_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="又是躺平的一天呢"
                            android:textSize="12sp"
                            android:textColor="#999999"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_vertical" />
                        <ImageView
                            style="@style/ItemArrowStyle" />
                    </LinearLayout>
                </LinearLayout>


            </LinearLayout>
        </ScrollView>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
