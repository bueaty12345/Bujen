<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7EFE2"
    tools:context=".guidance.CircumstanceActivity">

    <LinearLayout
        android:id="@+id/linearLayout11"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            >

            <ImageView
                android:id="@+id/img_back"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="0dp"
                app:srcCompat="@drawable/back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"  />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="关于你"
                android:textColor="#000000"
                android:textSize="24sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"  />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:backgroundTint="#DED1C1"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="87dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_left" />

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="具体情况"
                    android:textSize="24sp"
                    android:textColor="#000000"
                    android:layout_marginHorizontal="16dp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="87dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_right" />
            </LinearLayout>
            <TextView
                android:id="@+id/tv_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(多选)"
                android:textColor="#888888"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                android:layout_gravity="center" />

            <GridLayout
                android:id="@+id/guidance_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:alignmentMode="alignMargins"
                android:rowOrderPreserved="false"
                android:useDefaultMargins="true">

                <TextView
                    android:id="@+id/option1"
                    style="@style/GuidanceOptionStyle"
                    android:text="压力" />

                <TextView
                    android:id="@+id/option2"
                    style="@style/GuidanceOptionStyle"
                    android:text="失恋" />

                <TextView
                    android:id="@+id/option3"
                    style="@style/GuidanceOptionStyle"
                    android:text="暴躁" />

                <TextView
                    android:id="@+id/option4"
                    style="@style/GuidanceOptionStyle"
                    android:text="空虚" />

                <TextView
                    android:id="@+id/option5"
                    style="@style/GuidanceOptionStyle"
                    android:text="厌世" />

                <TextView
                    android:id="@+id/option6"
                    style="@style/GuidanceOptionStyle"
                    android:text="失眠" />
                <TextView
                    android:id="@+id/option7"
                    style="@style/GuidanceOptionStyle"
                    android:text="抑郁" />
            </GridLayout>

        </LinearLayout>

    </LinearLayout>
    <TextView
        android:id="@+id/btn_continue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="确定"
        android:gravity="center"
        android:layout_margin="24dp"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_continue_btn"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

